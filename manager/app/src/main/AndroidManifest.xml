<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ 状态常驻通知需运行时权限（M3e）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 11+ 包可见性：无 QUERY_ALL_PACKAGES 时 getInstalledPackages 只返回系统
         应用（229/230 system），用户应用（微信/抖音等）不可见。Scope 页需全量列表。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".DripManagerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DripManager">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DripManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M25 动态作用域请求弹窗：daemon 通知点进来的「小型弹窗」（对话框主题，自身不占 recents）。
             寄生模式下 framework 靠本声明（getPackageArchiveInfo(GET_ACTIVITIES) 解析 manager APK）
             才能拿到它的 ActivityInfo，从而把宿主 Activity 的启动重定向到本类。 -->
        <activity
            android:name=".ui.ScopeRequestDialogActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.DripManager.Dialog" />
    </application>

</manifest>
